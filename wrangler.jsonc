// Cấu hình Worker của Solaris. Một Worker cho tất cả: API (/api/*), kết nối trực tiếp (Durable Object)
// và bản build của frontend (static assets). Xem docs/kien-truc.md mục 9.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tên Worker là "app": địa chỉ khi deploy là https://app.solaris-fbs.workers.dev
  "name": "app",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: dùng node:crypto (băm đồng bộ) và Buffer.
  "compatibility_flags": ["nodejs_compat"],

  // Máy dev: cổng 4000 và 127.0.0.1 như backend cũ, để environment "Solaris local" của Postman dùng lại được.
  "dev": { "port": 4000, "ip": "127.0.0.1" },

  // Bản build của frontend (scripts/sync-frontend.mjs chép từ "../Solaris FE/dist").
  // Worker CHỈ chạy cho /api và /api/*. Mọi đường dẫn khác do tầng file tĩnh của Cloudflare tự trả, không gọi Worker và
  // không tính vào hạn mức request: file có thật thì trả file, còn lại (đường dẫn của ứng dụng như /orders/123, và cả đường
  // bot dò quét như /wp-login.php, /.env) nhận index.html. Đây là lớp chống bot làm hao request: địa chỉ workers.dev không
  // có tường lửa, nên cách duy nhất không mất request là không để Worker chạy.
  // Đánh đổi đã chấp nhận: file thiếu (ví dụ một gói JS cũ sau lần deploy) nhận index.html thay cho 404.
  // run_worker_first dạng mảng cũng tắt luật "chỉ request điều hướng mới nhận index.html", nên bot không gửi header của
  // trình duyệt cũng không lọt vào Worker (đã thử trên wrangler dev; tài liệu của Cloudflare chỗ này không nhất quán).
  "assets": {
    "directory": "./frontend-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },

  // database_id dưới đây là mã giữ chỗ (toàn số 0), đủ cho D1 cục bộ. D1 thật tạo bằng `wrangler d1 create solaris`.
  // KHÔNG dán mã thật vào đây (đổi mã là D1 cục bộ của mọi server dev thành file khác, mất dữ liệu thử):
  // chạy `node scripts/make-deploy-config.mjs --d1 <mã thật>` rồi `npx wrangler deploy -c wrangler.deploy.jsonc`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solaris",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Một Durable Object giữ mọi WebSocket của màn góp ý (docs/kien-truc.md mục 5). Gói miễn phí chỉ có loại SQLite.
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "RealtimeHub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }],

  // Việc định kỳ (src/jobs/index.js chọn việc theo biểu thức cron). Giờ UTC.
  "triggers": {
    "crons": [
      // Mỗi giờ: phiên và state hết hạn, bộ đếm hạn mức cũ, thùng rác kho file.
      "23 * * * *",
      // Mỗi 6 giờ: file tạm quá 1 ngày trên kho, bản cũ của đơn đã bàn giao quá 30 ngày.
      "41 */6 * * *",
    ],
  },

  // Giới hạn tần suất theo IP (docs/kien-truc.md mục 6). period chỉ nhận 10 hoặc 60 giây.
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "GUEST_WRITE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SOCKET_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 120, "period": 60 },
    },
  ],

  // Giá trị không bí mật, đi theo bản deploy. Máy dev ghi đè bằng .dev.vars (xem .dev.vars.example).
  // Khóa bí mật (OWNER_EMAIL không bí mật nhưng riêng từng nơi, GOOGLE_CLIENT_SECRET, CLOUDINARY_URL, RESEND_API_KEY) đặt bằng `wrangler secret put`.
  "vars": {
    // "production" là mặc định an toàn: đăng nhập dev chỉ bật khi .dev.vars đặt ENVIRONMENT=development.
    "ENVIRONMENT": "production",
    // Origin đầu tiên là gốc của link chia sẻ, đoạn nhúng bridge.js và nơi chuyển về sau đăng nhập Google:
    // phải trùng địa chỉ người dùng mở ứng dụng.
    "CLIENT_ORIGINS": "https://app.solaris-fbs.workers.dev",
    "SESSION_HOURS": "12",
    "LOG_LEVEL": "info",
    // Trần mỗi ngày (UTC) của gói miễn phí, dùng để tính phần trăm ở GET /api/v1/usage và để cảnh báo ở 70% và 90%.
    // Đổi khi Cloudflare đổi hạn mức hoặc khi nâng gói. Email cảnh báo cần thêm khóa bí mật RESEND_API_KEY (xem README.md).
    "USAGE_LIMIT_REQUESTS": "100000",
    "USAGE_LIMIT_ROWS_READ": "5000000",
    "USAGE_LIMIT_ROWS_WRITTEN": "100000",
    // Một chỉ số đạt chừng này phần trăm thì API tạm ngừng (trả 503 "quota_paused") tới 00:00 UTC.
    "USAGE_PAUSE_PERCENT": "97",
  },

  "observability": { "enabled": true },
}
