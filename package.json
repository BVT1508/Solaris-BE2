{
  "name": "solaris-cf",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Solaris chạy trên Cloudflare Workers: API, kết nối trực tiếp và bản build frontend trong một Worker.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "sync-frontend": "node scripts/sync-frontend.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "17.14.0",
    "prettier": "^3.10.1",
    "wrangler": "^4.164.0"
  }
}
